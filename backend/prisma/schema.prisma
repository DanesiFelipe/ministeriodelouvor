generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  username             String                @unique
  phone                String?
  passwordHash         String
  role                 String                @default("MEMBER")
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberBands          MemberBand[]
  memberRoles          MemberRole[]
  notices              Notice[]
  repertoires          Repertoire[]
  scheduleParticipants ScheduleParticipant[]
  unavailabilities     Unavailability[]
}

model Role {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  createdAt            DateTime              @default(now())
  memberRoles          MemberRole[]
  scheduleParticipants ScheduleParticipant[]
  memberBands          MemberBand[]
}

model MemberRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Band {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  memberBands MemberBand[]
  schedules   Schedule[]
}

model MemberBand {
  id        String   @id @default(uuid())
  userId    String
  bandId    String
  roleId    String
  createdAt DateTime @default(now())
  band      Band     @relation(fields: [bandId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, bandId, roleId])
}

model Service {
  id          String       @id @default(uuid())
  type        String
  date        DateTime
  time        String?
  status      String       @default("SCHEDULED")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  repertoires Repertoire[]
  schedules   Schedule[]
}

model Unavailability {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  reason    String?
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Schedule {
  id           String                @id @default(uuid())
  serviceId    String
  bandId       String?
  status       String                @default("DRAFT")
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  band         Band?                 @relation(fields: [bandId], references: [id])
  service      Service               @relation(fields: [serviceId], references: [id])
  participants ScheduleParticipant[]
}

model ScheduleParticipant {
  id         String   @id @default(uuid())
  scheduleId String
  userId     String
  roleId     String
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id])
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId, roleId])
}

model Song {
  id              String           @id @default(uuid())
  title           String
  artist          String?
  key             String?
  tonality        String?
  links           String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  repertoireSongs RepertoireSong[]
}

model Repertoire {
  id         String           @id @default(uuid())
  serviceId  String
  ministerId String
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  minister   User             @relation(fields: [ministerId], references: [id])
  service    Service          @relation(fields: [serviceId], references: [id])
  songs      RepertoireSong[]
}

model RepertoireSong {
  id           String     @id @default(uuid())
  repertoireId String
  songId       String
  order        Int
  key          String?
  createdAt    DateTime   @default(now())
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id])
  song         Song       @relation(fields: [songId], references: [id])

  @@unique([repertoireId, songId])
}

model IntegrationEvent {
  id        String   @id @default(uuid())
  type      String
  status    String
  message   String?
  createdAt DateTime @default(now())
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  creatorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User     @relation(fields: [creatorId], references: [id])
}
